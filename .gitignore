# ******************************************
# Root Git Ignore for Lantern Loft
# Covers both:
#   - backend/ (Laravel)
#   - frontend/ (Vue 3 + Vite)
# ******************************************

# ******************************************
# Frontend (Vue + Vite)
# ******************************************

# Logs
frontend/logs
frontend/*.log
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
frontend/lerna-debug.log*

# Dependencies & builds
frontend/node_modules
frontend/dist
frontend/dist-ssr
frontend/*.local

# Editor directories and files
frontend/.vscode/*
!frontend/.vscode/extensions.json
frontend/.idea
frontend/.DS_Store
frontend/*.suo
frontend/*.ntvs*
frontend/*.njsproj
frontend/*.sln
frontend/*.sw?

# Environment files
frontend/.env
frontend/.env.local
frontend/.env.*.local

# ******************************************
# Backend (Laravel)
# ******************************************

# Laravel specific
backend/vendor
backend/node_modules
backend/public/storage
backend/storage/*.key
backend/storage/framework/*
backend/storage/logs/*
backend/storage/debugbar/*
backend/storage/app/public

# Laravel environment & cache
backend/.env
backend/.env.*
backend/.phpunit.result.cache
backend/.fleet
backend/.vscode
backend/.idea
backend/.DS_Store

# Compiled & cache files
backend/bootstrap/cache/*.php
backend/storage/*.cache
backend/storage/logs/*.log
backend/storage/framework/cache/*
backend/storage/framework/views/*
backend/storage/framework/sessions/*
backend/storage/framework/testing/*
backend/storage/debugbar/*

# ******************************************
# Common root-level ignores
# ******************************************

# OS / Editor files
.DS_Store
Thumbs.db

# Env files
.env
.env.*

# Dependency directories (if any accidentally installed at root)
node_modules
vendor

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDE / Editor
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Husky
.husky/*

# TODOs
*.todo

# Dev Journal
dev-journal.md